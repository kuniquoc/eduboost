# LLM — custom endpoint (priority) or OpenAI fallback
QUIZ_LLM_ENDPOINT=
QUIZ_LLM_MODEL=
EXPLAIN_LLM_ENDPOINT=
EXPLAIN_LLM_MODEL=
OPENAI_API_KEY=

# RAG / Vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=models/vector_db/faiss_index

# CORS — comma-separated origins (use * only for local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Tutor session store (file-backed; orphan endpoints only)
AGENT_SESSION_DIR=data/agent_sessions

# Quiz batch — parallel LLM calls (default 1 for single-GPU; use 2-4 with vLLM)
QUIZ_BATCH_MAX_CONCURRENT=1
