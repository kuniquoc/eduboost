# Required for production server (docker-compose server service)
JWT_SECRET=generate-a-strong-secret-at-least-32-chars

# Optional — OpenAI fallback when custom LLM endpoints are not set
OPENAI_API_KEY=sk-...

# AI chat uses OpenAI directly
CHAT_LLM_MODEL=gpt-4o

# Optional — CORS for AI agent (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional — custom LLM servers (vLLM, etc.), higher priority than OpenAI
# QUIZ_LLM_ENDPOINT=http://vllm:8000/v1
# QUIZ_LLM_MODEL=quiz-adapter
# EXPLAIN_LLM_ENDPOINT=http://vllm:8000/v1
# EXPLAIN_LLM_MODEL=explanation-adapter
